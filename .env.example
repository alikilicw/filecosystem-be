# Copy to .env for running the API from source against `docker compose up -d`.
APP_ENV=development
HTTP_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_BYTES=52428800
FILE_TTL=24h

MONGO_URI=mongodb://filecosystem:filecosystem@localhost:27017/filecosystem?authSource=admin
MONGO_DATABASE=filecosystem
RABBITMQ_URL=amqp://filecosystem:filecosystem@localhost:5672/

# Amazon S3 — leave S3_ENDPOINT empty for real AWS.
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
S3_USE_PATH_STYLE=false
S3_PRESIGN_TTL=1h
